# PostgreSQL (HC4)
DATABASE_URL=postgresql://user:password@host:5432/crawlers

# YouTube API
YOUTUBE_API_KEY=

# Gemini API (watch-ai 요약)
GEMINI_API_KEY=

# watch-playwright 동시 Chromium 인스턴스 수
MAX_CONCURRENCY=1

# watch-runner
SUMMARIZE_CONCURRENCY=4
MAX_FAIL_COUNT=5

# watch-ai
RPD_LIMIT=1500
SUMMARIZER=transcript
