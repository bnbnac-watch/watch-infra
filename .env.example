# PostgreSQL (HC4, 사설망이라 SSL 미사용 — dbmate가 sslmode 미지정 시 SSL을 요구하므로 disable 명시)
DATABASE_URL=postgresql://user:password@host:5432/watchdb?sslmode=disable

# YouTube API
YOUTUBE_API_KEY=

# Gemini API (watch-ai 요약)
GEMINI_API_KEY=

# watch-playwright 동시 Chromium 인스턴스 수
MAX_CONCURRENCY=1

# watch-playwright 컨테이너 메모리 상한. Chromium이 OOM killer에 죽더라도
# 이 컨테이너 안에서만 죽도록 봉쇄한다 (다른 서비스 보호 목적).
# N2+ 서버(3.5GB, swap 없음) 실측 기준(2026-08-21): 다른 8개 서비스 + 이 서버에서
# 같이 도는 무관한 프로젝트(yt-downloader, honeymoon-note-app) 합쳐 ~615MB,
# watch-playwright 자체는 baseline ~420MB, 원티드 렌더 중 peak ~630MB 관측.
# 무거운 페이지 대비 여유를 두고 1280m으로 설정 — 다른 서버로 옮기면 재실측 필요.
# 너무 낮게 잡으면 렌더가 반복 실패해 watch-runner의 MAX_FAIL_COUNT(기본 5)에 의해 크롤러가 자동 비활성화될 수 있다.
PLAYWRIGHT_MEM_LIMIT=1280m

# watch-runner
SUMMARIZE_CONCURRENCY=4
MAX_FAIL_COUNT=5

# watch-ai
RPD_LIMIT=1500
SUMMARIZER=transcript
# 503 잦을 때 모델 교체 실험용 (미지정 시 gemini-3.5-flash)
GEMINI_MODEL=gemini-3.5-flash
